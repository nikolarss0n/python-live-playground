# Public HTTPS companion for zero-install Web APIs demos (no trailing slash)
# Example after Fly deploy: https://python-live-companion.fly.dev
VITE_COMPANION_URL=

# Jev (TypeSafe) for error-cause hints. Server-side only: read by the Vite dev/preview
# middleware, never exposed to the browser. Put real values in .env.local.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
